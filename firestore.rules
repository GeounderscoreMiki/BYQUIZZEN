rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Hvor på Fyn? ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /fyn_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /fyn_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Hvor i Hovedstaden? ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /hov_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 15
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /hov_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Hvor i Midtjylland? ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /mj_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /mj_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Hvor i Nordjylland? ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /nj_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /nj_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Hvor på Sjælland? ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /sjl_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /sjl_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Hvor i Sønderjylland? ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /sdj_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /sdj_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Hvor på Fyn? (eksisterende – uændret) ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /hpf_scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /hpf_stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }

    // ---- Fynsspil (eksisterende – uændret) ----
    // Scoreboard: alle kan læse og tilføje en score, men ikke ændre eller slette.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'seconds', 'lives', 'createdAt'])
        && request.resource.data.lives is int
        && request.resource.data.lives >= 1
        && request.resource.data.lives <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 20
        && request.resource.data.seconds <= 86400;
      allow update, delete: if false;
    }

    // Tæller: kan kun tælles op med 1 ad gangen (attempts = spillere, completed = vindere).
    match /stats/counters {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) <= 1
        && request.resource.data.get('completed', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['attempts', 'completed'])
        && request.resource.data.get('attempts', 0) - resource.data.get('attempts', 0) in [0, 1]
        && request.resource.data.get('completed', 0) - resource.data.get('completed', 0) in [0, 1];
    }
  }
}
